# ============================================================
# SIGAP AI — Environment Variables
# Copy this file to ".env" and fill in real values.
# All three are REQUIRED — the app validates them at boot (src/env.ts).
# ============================================================

# --- PostgreSQL (Neon.tech atau Supabase, free tier) ---
# Gunakan connection string dengan pooling untuk serverless (Vercel).
# Neon contoh: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Supabase co
ntoh: postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@host:5432/sigap?sslmode=require"

# (opsional) URL koneksi langsung (non-pooled) untuk `prisma migrate`.
# Neon: gunakan host TANPA "-pooler". Jika tidak diisi, Prisma pakai DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/sigap?sslmode=require"

# --- Google Gemini API (AI Studio, free tier) ---
# Dapatkan di https://aistudio.google.com/apikey
# HANYA dibaca di server (Route Handler) — tidak pernah dikirim ke client.
GEMINI_API_KEY="your-gemini-api-key"

# --- Auth.js (NextAuth v5) ---
# Generate: openssl rand -base64 32   (atau: npx auth secret)
AUTH_SECRET="generate-a-32-byte-random-secret"

# (opsional) URL kanonik aplikasi. Di Vercel diisi otomatis; isi untuk dev jika perlu.
# AUTH_URL="http://localhost:3000"
